# Copy this file to .env and fill in your own API keys.
# Never commit .env to git.

GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Optional: override the directory the "Browse Downloads" picker reads from.
# Defaults to ~/Downloads. Useful if macOS is blocking access to that folder.
# DOCCHAT_DOWNLOADS_DIR=~/Documents/docchat-inbox
